# Copy this file to .env and edit it:  cp .env.example .env

# ":80" = plain HTTP on your home network.
# Or a domain name (e.g. list.example.com) for automatic HTTPS.
SITE_ADDRESS=:80

# Logins: one line per person, LOGIN_<USERNAME>=<password hash>
# Usernames are not case-sensitive. Make a hash with:
#   docker compose run --rm api node /app/hash-password.js 'the password'
# then run: docker compose up -d
LOGIN_ALEX=PASTE_HASH_HERE
LOGIN_SAM=PASTE_HASH_HERE
LOGIN_RILEY=PASTE_HASH_HERE

# Admins can see and change everyone's meal and exercise ticks, ratings and notes, and reset everything.
ADMIN_USERS=alex

# Which person in the plan each login ticks as (default: the username).
# PERSON_ALEX=alex
