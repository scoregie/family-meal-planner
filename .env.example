# Copy this file to .env and edit it:  cp .env.example .env

# ":80" = plain HTTP on your home network.
# Or a domain name (e.g. list.example.com) for automatic HTTPS.
SITE_ADDRESS=:80

# Logins: open the site and create the family's first account (you'll be the owner), then
# invite everyone else from Family in the account menu. Nothing to set here.

# Optional: send invite and "forgot password" emails (otherwise you share the links yourself).
# SMTP_URL=smtps://you%40gmail.com:your-app-password@smtp.gmail.com:465
# MAIL_FROM=Family Health Planner <you@gmail.com>
# APP_URL=https://planner.example.com

# Older servers: username logins still work (LOGIN_<USERNAME>=<hash from hash-password.js>,
# ADMIN_USERS=alex, PERSON_ALEX=alex). People are asked to add their email when they log in.

# Optional: the Claude assistant ("Ask Claude"). Get a key at console.anthropic.com.
# See "Ask Claude" in the README for what is sent to Anthropic and roughly what it costs.
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_DAILY_LIMIT=40
