# Copy this file to .env and edit it:  cp .env.example .env

# ":80" = plain HTTP on your home network.
# Or a domain name (e.g. list.example.com) for automatic HTTPS.
SITE_ADDRESS=:80

# Logins: open the site and create the family's first account (you'll be the owner), then
# invite everyone else from Family in the account menu. Nothing to set here.

# Optional: send invite and "forgot password" emails (otherwise you share the links yourself).
# SMTP_URL=smtps://you%40gmail.com:your-app-password@smtp.gmail.com:465
# MAIL_FROM=Family Health Planner <you@gmail.com>
# APP_URL=https://planner.example.com

# Older servers: username logins still work (LOGIN_<USERNAME>=<hash from hash-password.js>,
# ADMIN_USERS=alex, PERSON_ALEX=alex). People are asked to add their email when they log in.

# Optional: AI for drafting plans and the "Ask AI" chat. Add a key for any you want, restart
# (docker compose up -d), then choose one on Plan setup. Without any, the built-in plan builder
# still drafts plans. See "Choosing an AI" in the README for costs and what is sent.
# Claude: console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# OpenAI: platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# Google Gemini: aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# A local Ollama server (free, runs on your own computer):
# OLLAMA_URL=http://192.168.1.20:11434
# The Claude model (for the other AIs, choose the model on Plan setup):
# ASSISTANT_MODEL=claude-opus-5-5
# Claude only: low, medium or high
# ASSISTANT_EFFORT=medium
# Chat messages per login per day (not for people using their own key):
# ASSISTANT_DAILY_LIMIT=40
